# .env 서식 — 값은 비워 둔 견본. 실제 값은 .env 에 넣는다.

# Anthropic (Claude API) — console.anthropic.com 에서 발급. 서버만 읽고 브라우저로는 내려가지 않는다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Notion (읽기 전용 통합)
#   NOTION_TOKEN      'kma' 통합 — 제안 프로그램 카탈로그
#   NOTION_VOC_TOKEN  'KMA 자동화' 통합 — 교육문의(VOC) · 제안서 DB
NOTION_TOKEN=
NOTION_VOC_TOKEN=
NOTION_VOC_DB=
NOTION_PROPOSAL_DB=

# Supabase
#   URL · PUBLISHABLE_KEY  공개 가능 (브라우저로 내려간다)
#   SECRET_KEY (sb_secret_…)  비밀 — 계정 표(accounts)와 파일 보관소를 여는 열쇠. 로그인에 꼭 필요.
#   ACCESS_TOKEN (sbp_…)      비밀 — 선택. 관리자 화면의 연결 확인에서만 쓴다.
#   계정 표는 server/sql/001_accounts.sql 을 SQL Editor 에서 한 번 실행해 만든다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SECRET_KEY=

# 로그인 표 서명 열쇠 — 선택. 비우면 SUPABASE_SECRET_KEY 에서 뽑는다.
# 따로 두면 secret key 를 바꿔도 모두가 다시 로그인하지 않아도 된다.
KMA_SESSION_SECRET=

# 로컬에서도 로그인을 반드시 받으려면 1 (배포한 웹은 늘 받는다)
KMA_REQUIRE_LOGIN=

# 로컬에서 '클래식' 아웃룩 새 메일 창을 직접 띄우려면 1.
# 비우면 어디서나 메일 파일(.eml)을 만든다 — 새 Outlook 은 이 파일로만 열 수 있다.
KMA_OUTLOOK=
